# Django
DJANGO_SETTINGS_MODULE=zamukapay.settings.local
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose service "db")
POSTGRES_DB=zamukapay
POSTGRES_USER=zamukapay
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (matches docker-compose service "redis")
REDIS_URL=redis://redis:6379/0

# CORS — origins allowed to call this API with credentials
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
REFRESH_COOKIE_SECURE=False

# Email (console backend prints to stdout in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@zamukapay.rw
